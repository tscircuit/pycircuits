{
  "name": "pycircuits",
  "version": "0.1.1",
  "description": "Bootstrap a Python-facing tscircuit workflow from @tscircuit/props.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tscircuit/pycircuits.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pycircuits": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/render_python_entry.py"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "build:circuit": "bun run src/cli.ts build",
    "cli": "bun run src/cli.ts",
    "generate": "bun run src/cli.ts generate",
    "prepare": "tsup",
    "start": "bun run src/cli.ts start",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tscircuit/props": "^0.0.506",
    "@types/bun": "latest",
    "@types/node": "^25.6.0",
    "tsup": "8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@flatten-js/core": "^1.6.12",
    "@lume/kiwi": "^0.4.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tscircuit/alphabet": "^0.0.25",
    "@tscircuit/capacity-autorouter": "^0.0.434",
    "@tscircuit/checks": "^0.0.117",
    "@tscircuit/circuit-json-flex": "^0.0.4",
    "@tscircuit/circuit-json-util": "^0.0.92",
    "@tscircuit/copper-pour-solver": "^0.0.20",
    "@tscircuit/core": "^0.0.1170",
    "@tscircuit/eval": "^0.0.763",
    "@tscircuit/footprinter": "^0.0.351",
    "@tscircuit/infer-cable-insertion-point": "^0.0.2",
    "@tscircuit/infgrid-ijump-astar": "^0.0.35",
    "@tscircuit/matchpack": "^0.0.16",
    "@tscircuit/math-utils": "^0.0.36",
    "@tscircuit/miniflex": "^0.0.4",
    "@tscircuit/mm": "^0.0.9",
    "@tscircuit/ngspice-spice-engine": "^0.0.8",
    "@tscircuit/runframe": "^0.0.1836",
    "@tscircuit/schematic-match-adapt": "^0.0.22",
    "@tscircuit/schematic-trace-solver": "^0.0.47",
    "@tscircuit/simple-3d-svg": "^0.0.41",
    "@tscircuit/solver-utils": "^0.0.19",
    "@tscircuit/soup-util": "^0.0.41",
    "bpc-graph": "^0.0.66",
    "calculate-elbow": "^0.0.12",
    "calculate-packing": "^0.0.71",
    "circuit-json": "^0.0.413",
    "circuit-json-to-bpc": "^0.0.13",
    "circuit-json-to-connectivity-map": "^0.0.23",
    "circuit-json-to-gltf": "^0.0.95",
    "circuit-json-to-simple-3d": "^0.0.9",
    "circuit-json-to-spice": "^0.0.34",
    "circuit-to-svg": "^0.0.343",
    "comlink": "^4.4.2",
    "connectivity-map": "^1.0.0",
    "css-select": "^7.0.0",
    "debug": "^4.4.3",
    "flatbush": "^4.5.1",
    "format-si-unit": "^0.0.3",
    "graphics-debug": "^0.0.91",
    "jscad-planner": "^0.0.14",
    "kicad-component-converter": "^0.1.40",
    "kicad-to-circuit-json": "^0.0.42",
    "kicadts": "^0.0.27",
    "minicssgrid": "^0.0.9",
    "performance-now": "^2.1.0",
    "poppygl": "^0.0.20",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-reconciler": "^0.33.0",
    "s-expression": "^3.1.1",
    "schematic-symbols": "^0.0.224",
    "spicey": "^0.0.14",
    "sucrase": "^3.35.1",
    "svg-path-commander": "^2.2.1",
    "transformation-matrix": "^3.1.0",
    "tscircuit": "^0.0.1651",
    "tslib": "^2.8.1",
    "zod": "^3.25.67"
  }
}
